# Copy this file to .env and fill in your own values.
# .env is ignored by Git and should never be committed.

# Keeps pending verification codes valid across server restarts.
# Use a long random value in a real deployment.
OTP_SECRET=

# Email delivery for account verification codes.
# Without these settings, codes appear only in the server window.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
OTP_FROM=your-email@gmail.com
